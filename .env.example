# Skopiuj do .env.local i uzupelnij wartosciami z konsoli Firebase.
# Wszystkie zmienne musza miec prefiks VITE_ (wymog Vite).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ustaw na "true", aby aplikacja laczyla sie z lokalnymi emulatorami.
VITE_USE_FIREBASE_EMULATORS=true

# Konto wlasciciela (Google). Tylko ono ma prawo dodawania/edycji/usuwania.
VITE_ADMIN_EMAIL=programistatf@gmail.com
