rules_version = '2';

// Reguly bezpieczenstwa dla BurStars ("Skala Burgerowa").
// Model: kazdy wpis burgera nalezy do zalogowanego uzytkownika (ownerUid).
// Odczyt publiczny (galeria ocen), zapis tylko dla wlasciciela wpisu.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funkcje pomocnicze ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Wlasciciel = konkretne, zweryfikowane konto Google.
    // UWAGA: ten email musi byc zgodny z VITE_ADMIN_EMAIL w .env.production —
    // zmieniajac jedno, zmien tez drugie (i opublikuj reguly ponownie).
    function isOwner() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'programistatf@gmail.com';
    }

    // Walidacja ksztaltu i typow wpisu burgera.
    function isValidBurger(data) {
      return data.keys().hasAll(['name', 'rating', 'ownerUid', 'createdAt'])
        // nazwa: niepusty string, max 120 znakow
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120
        // ocena: liczba 1..10 (dozwolone dziesietne, np. 7.5)
        && data.rating is number
        && data.rating >= 1
        && data.rating <= 10
        // wlasciciel musi zgadzac sie z zalogowanym userem
        && data.ownerUid is string
        && data.ownerUid == request.auth.uid
        // znacznik czasu utworzenia
        && data.createdAt is timestamp
        // pola opcjonalne: poprawny typ + limity rozmiaru
        // (zdjecia to Data URL-e w dokumencie — limity chronia przed
        // przekroczeniem 1 MB na dokument Firestore)
        && (!('locationName' in data) || (data.locationName is string && data.locationName.size() <= 200))
        && (!('lat' in data) || data.lat is number)
        && (!('lng' in data) || data.lng is number)
        && (!('photos' in data) || (data.photos is list && data.photos.size() <= 1))
        && (!('tags' in data) || (data.tags is list && data.tags.size() <= 20))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 5000))
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /burgers/{burgerId} {
      // Odczyt galerii dostepny publicznie (kazdy oglada bez logowania).
      allow read: if true;

      // Zapis tylko dla wlasciciela (konto Google programistatf@gmail.com).
      allow create: if isOwner() && isValidBurger(request.resource.data);
      allow update: if isOwner() && isValidBurger(request.resource.data);
      allow delete: if isOwner();
    }

    // Domyslnie: wszystko inne zablokowane.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
