rules_version = '2';

// Reguly Firebase Storage dla zdjec burgerow.
// Odczyt publiczny (galeria). Zapis tylko wlasciciel do swojego katalogu,
// wylacznie obrazy do 5 MB.
service firebase.storage {
  match /b/{bucket}/o {
    match /burgers/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    // Domyslnie wszystko inne zablokowane.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
